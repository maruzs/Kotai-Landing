{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kotai-landing",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-06",
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/webmail", "/webmail/*"],
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
    {
      "binding": "KOTAI_KV",
      "id": "84e5d445882c499f88d74845055ad83f"
    }
  ]
}
